// PUT /admin/empresas/:id/whatsapp-proprio - Habilitar/desabilitar WhatsApp próprio
router.put('/empresas/:id/whatsapp-proprio', verificarSuperAdmin, async (req, res) => {
    try {
        const db = req.app.get('db');
        const { id } = req.params;
        const { habilitado } = req.body;
        
        // Verificar se empresa existe
        const empresa = await db.get('SELECT * FROM empresas WHERE id = ?', [id]);
        if (!empresa) {
            return res.status(404).json({ 
                success: false, 
                message: 'Empresa não encontrada' 
            });
        }
        
        // Atualizar
        await db.run(
            'UPDATE empresas SET whatsapp_proprio_habilitado = ? WHERE id = ?',
            [habilitado ? 1 : 0, id]
        );
        
        // Se habilitou, criar instância
        if (habilitado) {
            const instanceName = `emp-${id}`;
            await db.run(
                'UPDATE empresas SET whatsapp_instance = ? WHERE id = ?',
                [instanceName, id]
            );
            
            // Tentar criar instância na Evolution API
            try {
                const evolutionService = req.app.get('evolutionService');
                if (evolutionService && typeof evolutionService.createInstance === 'function') {
                    await evolutionService.createInstance(instanceName);
                }
            } catch (e) {
                console.warn('⚠️ Erro ao criar instância:', e);
            }
        }
        
        const updated = await db.get('SELECT * FROM empresas WHERE id = ?', [id]);
        res.json({ success: true, data: updated });
    } catch (error) {
        console.error('❌ Erro ao alterar WhatsApp:', error);
        res.status(500).json({ 
            success: false, 
            message: error.message 
        });
    }
});

