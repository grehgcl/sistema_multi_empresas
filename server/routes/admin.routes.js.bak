const express = require('express');
const router = express.Router();

// ===== MIDDLEWARE DE AUTENTICAÇÃO =====
function verificarSuperAdmin(req, res, next) {
    if (!req.session || !req.session.user) {
        return res.status(401).json({ 
            success: false, 
            message: 'Não autenticado' 
        });
    }
    
    const role = req.session.user.role;
    if (role !== 'super_admin' && role !== 'superadmin') {
        return res.status(403).json({ 
            success: false, 
            message: 'Acesso negado. Apenas Super Admin.' 
        });
    }
    
    next();
}

// ===== ROTAS =====

// GET /admin/stats - Estatísticas gerais
router.get('/stats', verificarSuperAdmin, async (req, res) => {
    try {
        const db = req.app.get('db');
        
        // Total de empresas
        const totalEmpresas = await db.get('SELECT COUNT(*) as total FROM empresas');
        
        // Empresas ativas
        const empresasAtivas = await db.get(
            "SELECT COUNT(*) as total FROM empresas WHERE status = 'ativa' OR status = 'ativo'"
        );
        
        // Empresas em trial
        const empresasTrial = await db.get(
            "SELECT COUNT(*) as total FROM empresas WHERE plano = 'trial'"
        );
        
        // Total de usuários
        const totalUsuarios = await db.get('SELECT COUNT(*) as total FROM usuarios');
        
        // Total de agendamentos
        const totalAgendamentos = await db.get('SELECT COUNT(*) as total FROM agendamentos');
        
        res.json({
            success: true,
            data: {
                totalEmpresas: totalEmpresas?.total || 0,
                empresasAtivas: empresasAtivas?.total || 0,
                empresasTrial: empresasTrial?.total || 0,
                totalUsuarios: totalUsuarios?.total || 0,
                totalAgendamentos: totalAgendamentos?.total || 0
            }
        });
    } catch (error) {
        console.error('❌ Erro ao buscar stats:', error);
        res.status(500).json({ 
            success: false, 
            message: error.message 
        });
    }
});

// GET /admin/empresas - Listar todas as empresas
router.get('/empresas', verificarSuperAdmin, async (req, res) => {
    try {
        const db = req.app.get('db');
        const empresas = await db.all('SELECT * FROM empresas ORDER BY id DESC');
        res.json({ success: true, data: empresas });
    } catch (error) {
        console.error('❌ Erro ao listar empresas:', error);
        res.status(500).json({ 
            success: false, 
            message: error.message 
        });
    }
});

// GET /admin/empresas/:id - Buscar uma empresa
router.get('/empresas/:id', verificarSuperAdmin, async (req, res) => {
    try {
        const db = req.app.get('db');
        const { id } = req.params;
        const empresa = await db.get('SELECT * FROM empresas WHERE id = ?', [id]);
        
        if (!empresa) {
            return res.status(404).json({ 
                success: false, 
                message: 'Empresa não encontrada' 
            });
        }
        
        res.json({ success: true, data: empresa });
    } catch (error) {
        console.error('❌ Erro ao buscar empresa:', error);
        res.status(500).json({ 
            success: false, 
            message: error.message 
        });
    }
});

// PUT /admin/empresas/:id - Atualizar empresa
router.put('/empresas/:id', verificarSuperAdmin, async (req, res) => {
    try {
        const db = req.app.get('db');
        const { id } = req.params;
        const { nome, telefone, email, plano, status, trial_fim, whatsapp_instance } = req.body;
        
        // Verificar se empresa existe
        const empresa = await db.get('SELECT * FROM empresas WHERE id = ?', [id]);
        if (!empresa) {
            return res.status(404).json({ 
                success: false, 
                message: 'Empresa não encontrada' 
            });
        }
        
        // Atualizar
        await db.run(
            `UPDATE empresas SET 
                nome = COALESCE(?, nome),
                telefone = COALESCE(?, telefone),
                email = COALESCE(?, email),
                plano = COALESCE(?, plano),
                status = COALESCE(?, status),
                trial_fim = COALESCE(?, trial_fim),
                whatsapp_instance = COALESCE(?, whatsapp_instance)
            WHERE id = ?`,
            [nome, telefone, email, plano, status, trial_fim, whatsapp_instance, id]
        );
        
        const updated = await db.get('SELECT * FROM empresas WHERE id = ?', [id]);
        res.json({ success: true, data: updated });
    } catch (error) {
        console.error('❌ Erro ao atualizar empresa:', error);
        res.status(500).json({ 
            success: false, 
            message: error.message 
        });
    }
});

// DELETE /admin/empresas/:id - Excluir empresa
router.delete('/empresas/:id', verificarSuperAdmin, async (req, res) => {
    try {
        const db = req.app.get('db');
        const { id } = req.params;
        
        // Verificar se empresa existe
        const empresa = await db.get('SELECT * FROM empresas WHERE id = ?', [id]);
        if (!empresa) {
            return res.status(404).json({ 
                success: false, 
                message: 'Empresa não encontrada' 
            });
        }
        
        // Excluir
        await db.run('DELETE FROM empresas WHERE id = ?', [id]);
        
        res.json({ 
            success: true, 
            message: 'Empresa excluída com sucesso' 
        });
    } catch (error) {
        console.error('❌ Erro ao excluir empresa:', error);
        res.status(500).json({ 
            success: false, 
            message: error.message 
        });
    }
});

