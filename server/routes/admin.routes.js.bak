// GET /admin/logs - Logs de acesso
router.get('/logs', verificarSuperAdmin, async (req, res) => {
    try {
        const db = req.app.get('db');
        
        // Verificar se existe tabela de logs
        const tableCheck = await db.get(
            "SELECT name FROM sqlite_master WHERE type='table' AND name='logs'"
        );
        
        let logs = [];
        if (tableCheck) {
            logs = await db.all('SELECT * FROM logs ORDER BY created_at DESC LIMIT 100');
        }
        
        res.json({ success: true, data: logs });
    } catch (error) {
        console.error('❌ Erro ao buscar logs:', error);
        res.status(500).json({ 
            success: false, 
            message: error.message 
        });
    }
});

// GET /admin/faturamento-mensal - Faturamento mensal
router.get('/faturamento-mensal', verificarSuperAdmin, async (req, res) => {
    try {
        const db = req.app.get('db');
        
        // Buscar faturamento dos últimos 6 meses
        const faturamento = await db.all(`
            SELECT 
                strftime('%Y-%m', data_hora) as mes,
                SUM(valor_total) as total
            FROM agendamentos
            WHERE status = 'confirmado'
            GROUP BY strftime('%Y-%m', data_hora)
            ORDER BY mes DESC
            LIMIT 6
        `);
        
        res.json({ success: true, data: faturamento });
    } catch (error) {
        console.error('❌ Erro ao buscar faturamento:', error);
        res.status(500).json({ 
            success: false, 
            message: error.message 
        });
    }
});

// POST /admin/ativar-whatsapp/:id - Ativar WhatsApp para empresa
router.post('/ativar-whatsapp/:id', verificarSuperAdmin, async (req, res) => {
    try {
        const db = req.app.get('db');
        const { id } = req.params;
        
        // Verificar se empresa existe
        const empresa = await db.get('SELECT * FROM empresas WHERE id = ?', [id]);
        if (!empresa) {
            return res.status(404).json({ 
                success: false, 
                message: 'Empresa não encontrada' 
            });
        }
        
        // Ativar WhatsApp
        const instanceName = `emp-${id}`;
        await db.run(
            'UPDATE empresas SET whatsapp_proprio_habilitado = 1, whatsapp_instance = ? WHERE id = ?',
            [instanceName, id]
        );
        
        // Tentar criar instância
        try {
            const evolutionService = req.app.get('evolutionService');
            if (evolutionService && typeof evolutionService.createInstance === 'function') {
                await evolutionService.createInstance(instanceName);
            }
        } catch (e) {
            console.warn('⚠️ Erro ao criar instância:', e);
        }
        
        const updated = await db.get('SELECT * FROM empresas WHERE id = ?', [id]);
        res.json({ success: true, data: updated });
    } catch (error) {
        console.error('❌ Erro ao ativar WhatsApp:', error);
        res.status(500).json({ 
            success: false, 
            message: error.message 
        });
    }
});

module.exports = router;