        </div>
        <div class="landing-right">
            <div id="loginContainer" class="auth-container active">
                <div class="auth-box">
                    <div class="auth-header">
                        <i class="fas fa-eye auth-icon"></i>
                        <h2>Bem-vindo de volta</h2>
