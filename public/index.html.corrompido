                    <div class="input-group">
                        <i class="fas fa-phone input-icon"></i>
                        <input type="tel" id="cadastroTelefone" placeholder="(41) 99999-9999" required>
                    </div>
                    <small
                        style="color:var(--text-muted);font-size:10px;display:block;margin-top:-8px;margin-bottom:8px;padding-left:40px;">
                        ?? ObrigatÃ¯Â¿Â½rio para receber notificaÃ¯Â¿Â½Ã¯Â¿Â½es do WhatsApp
                    </small>
                    <div class="auth-terms">
                        <label>
                            <input type="checkbox" id="acceptTerms" checked>
                            <span>Aceito os <a href="#"
                                    onclick="showToast('Termos de uso disponÃ¯Â¿Â½veis em breve.', 'info')">Termos de
                                    Uso</a>
                                e <a href="#"
                                    onclick="showToast('PolÃ¯Â¿Â½tica de privacidade disponÃ¯Â¿Â½vel em breve.', 'info')">PolÃ¯Â¿Â½tica
                                    de Privacidade</a></span>
                        </label>
                    </div>
                    <button class="btn-login" onclick="fazerCadastro()">
                        <i class="fas fa-rocket"></i> Criar conta grÃ¯Â¿Â½tis
                    </button>
                    <div id="cadastroMessage" class="error-message"></div>
                    <div class="auth-divider"><span>ou</span></div>
                    <div class="auth-footer">
                        <p>JÃ¯Â¿Â½ tem conta? <span onclick="mostrarLogin()">FaÃ¯Â¿Â½a login <i
                                    class="fas fa-arrow-right"></i></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="app" class="app" style="display:none">
        <div class="header header-glass">
