            <span class="close" onclick="fecharModal('modalUpgrade')">&times;</span>
            <h3>?? Fazer Upgrade</h3>
            <div id="upgradeContent"></div>
            <div class="modal-buttons">
                <button onclick="fecharModal('modalUpgrade')" class="btn-secondary">Cancelar</button>
            </div>
        </div>
    </div>


    <canvas id="particlesCanvas"
        style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: -1;"></canvas>

    <!-- ============================================
    SCRIPTS
    ============================================ -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <!-- UI PRIMEIRO (contÃ¯Â¿Â½m carregarCSS) -->
    <script src="/js/ui.js"></script>

    <!-- PÃ¯Â¿Â½GINAS -->
    <script src="/js/ui.js?v=20260804"></script>
    <script src="/js/pages/dashboard.js?v=20260804"></script>
    <script src="/js/pages/clientes.js?v=20260804"></script>
    <script src="/js/pages/agendamentos.js?v=20260804"></script>
    <script src="/js/pages/financeiro.js?v=20260804"></script>
    <script src="/js/pages/empresas.js?v=20260804"></script>
    <script src="/js/pages/configuracoes.js?v=20260804"></script>
    <script src="/js/pages/servicos.js?v=20260804"></script>
    <script src="/js/pages/planos.js?v=20260804"></script>
    <script src="/js/pages/whatsapp-config.js?v=20260804"></script>

    <script>
        AOS.init({ duration: 800, once: true });

        let token = null;
        let usuario = null;

        // ========== PARTÃ¯Â¿Â½CULAS ANIMADAS ==========
        // ... (mantenha o cÃ¯Â¿Â½digo das partÃ¯Â¿Â½culas)

        // ========== TOGGLE PASSWORD ==========
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const toggleBtn = input.parentElement.querySelector('.toggle-pwd');
            const icon = toggleBtn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye-slash';
            }
        }

        // ========== TOGGLE MOBILE MENU ==========
        function toggleMobileMenu() {
            document.getElementById('sidebar').classList.toggle('open');
            document.querySelector('.sidebar-overlay').classList.toggle('active');
        }

        // ========== FECHAR MODAL ==========
        function fecharModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) modal.style.display = 'none';
        }

        // ========== MODAL CLIENTE ==========
        function abrirModalCliente() {
            const modal = document.getElementById('modalCliente');
            if (modal) {
                modal.style.display = 'block';
                document.getElementById('formCliente').reset();
                document.getElementById('clienteId').value = '';
                document.getElementById('modalClienteTitle').textContent = 'Novo Cliente';
            } else {
                showToast('Modal nÃ¯Â¿Â½o encontrado', 'error');
            }
        }

        function fecharModalCliente() {
            const modal = document.getElementById('modalCliente');
            if (modal) modal.style.display = 'none';
        }

        // ========== AÃ¯Â¿Â½Ã¯Â¿Â½ES RÃ¯Â¿Â½PIDAS ==========
        function abrirModalAgendamentoRapido() {
            console.log('?? AÃ¯Â¿Â½Ã¯Â¿Â½o rÃ¯Â¿Â½pida: Novo Agendamento');
            if (typeof window.abrirModalAgendamentoDono === 'function') {
                if (typeof window.carregarDadosAgendamento === 'function') {
                    window.carregarDadosAgendamento().then(() => {
                        window.abrirModalAgendamentoDono();
                    });
                } else {
                    window.abrirModalAgendamentoDono();
                }
                return;
            }
            const modal = document.getElementById('modalAgendamento');
            if (modal) {
                modal.style.display = 'block';
                document.getElementById('formAgendamento').reset();
                document.getElementById('agendamentoId').value = '';
                document.getElementById('modalAgendamentoTitle').textContent = 'Novo Agendamento';
                carregarSelectsAgendamento();
            } else {
                showToast('Modal nÃ¯Â¿Â½o encontrado', 'error');
            }
        }

        function abrirModalClienteRapido() {
            console.log('?? AÃ¯Â¿Â½Ã¯Â¿Â½o rÃ¯Â¿Â½pida: Novo Cliente');
            if (typeof window.abrirModalCliente === 'function' && window.abrirModalCliente !== abrirModalClienteRapido) {
                window.abrirModalCliente();
                return;
            }
            abrirModalCliente();
        }

        // ========== AUTH ==========
        async function fazerLogin() {
            const email = document.getElementById('loginEmail').value;
            const senha = document.getElementById('loginSenha').value;
            if (!email || !senha) { showToast('Preencha todos os campos', 'warning'); return; }
            showLoading();
            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, senha })
                });
                const data = await res.json();
                hideLoading();

                console.log('Ã°Å¸â€œÂ¥ Resposta do login:', data);

                if (data.success) {
                    // Ã°Å¸â€Â¥ CORREÃƒâ€¡ÃƒÆ’O: Usar a variÃƒÂ¡vel GLOBAL
                    const token = data.token || data.data?.token;
                    const usuarioData = data.data?.usuario || data.data;

                    console.log('Ã°Å¸â€â€˜ Token encontrado:', token);
                    console.log('Ã°Å¸â€˜Â¤ Usuario encontrado:', usuarioData);

                    if (!token || token === 'undefined') {
                        console.error('Ã¢ÂÅ’ Token invÃƒÂ¡lido:', token);
                        showToast('Erro: token nÃƒÂ£o recebido', 'error');
                        return;
                    }

                    if (!usuarioData || !usuarioData.nome) {
                        console.error('Ã¢ÂÅ’ UsuÃƒÂ¡rio invÃƒÂ¡lido:', usuarioData);
                        showToast('Erro: dados do usuÃƒÂ¡rio incompletos', 'error');
                        return;
                    }

                    // Ã°Å¸â€Â¥ ATUALIZAR A VARIÃƒÂVEL GLOBAL
                    window.token = token;
                    window.usuario = usuarioData;

                    localStorage.setItem('token', token);
                    localStorage.setItem('usuario', JSON.stringify(usuarioData));

                    if (document.getElementById('rememberMe').checked) {
                        localStorage.setItem('rememberEmail', email);
                    } else {
                        localStorage.removeItem('rememberEmail');
                    }

                    console.log('Ã¢Å“â€¦ Token salvo:', localStorage.getItem('token'));
                    console.log('Ã¢Å“â€¦ Usuario salvo:', localStorage.getItem('usuario'));
                    console.log('Ã¢Å“â€¦ Usuario global:', window.usuario);

                    showToast('Login realizado com sucesso!', 'success');

                    // Ã°Å¸â€Â¥ USAR A FUNÃƒâ€¡ÃƒÆ’O GLOBAL DO UI.JS
                    if (typeof window.mostrarApp === 'function') {
                        window.mostrarApp();
                    } else {
                        mostrarApp();
                    }
                } else {
                    document.getElementById('loginMessage').innerHTML = data.message;
                    document.getElementById('loginMessage').style.display = 'block';
                    showToast(data.message, 'error');
                }
            } catch (error) {
                hideLoading();
                console.error('Ã¢ÂÅ’ Erro no login:', error);
                showToast('Erro ao fazer login', 'error');
            }
        }

        async function fazerCadastro() {
            const nome = document.getElementById('cadastroNome').value;
            const email = document.getElementById('cadastroEmail').value;
            const senha = document.getElementById('cadastroSenha').value;
            const empresa_nome = document.getElementById('cadastroEmpresa').value;
            const telefone = document.getElementById('cadastroTelefone').value;
            const acceptTerms = document.getElementById('acceptTerms').checked;

            if (!nome || !email || !senha || !empresa_nome || !telefone) {
                showToast('Preencha todos os campos obrigatÃ¯Â¿Â½rios (incluindo telefone)', 'warning');
                return;
            }

            if (senha.length < 6) {
                showToast('A senha deve ter pelo menos 6 caracteres', 'warning');
                return;
            }

            if (!acceptTerms) {
                showToast('Aceite os Termos de Uso para continuar', 'warning');
                return;
            }

            const telefoneLimpo = telefone.replace(/\D/g, '');
            if (telefoneLimpo.length < 10) {
                showToast('Digite um telefone vÃ¯Â¿Â½lido (ex: 41999999999)', 'warning');
                return;
            }

            showLoading();
            try {
                const res = await fetch('/api/auth/cadastro', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        nome,
                        email,
                        senha,
                        empresa_nome,
                        telefone: telefoneLimpo
                    })
                });
                const data = await res.json();
                hideLoading();
                if (data.success) {
                    document.getElementById('cadastroMessage').className = 'success-message';
                    document.getElementById('cadastroMessage').innerHTML = '? ' + data.message;
                    document.getElementById('cadastroMessage').style.display = 'block';
                    showToast(data.message, 'success');
                    setTimeout(() => {
                        if (typeof window.mostrarLogin === 'function') {
                            window.mostrarLogin();
                        } else {
                            mostrarLogin();
                        }
                    }, 3000);
                } else {
                    document.getElementById('cadastroMessage').className = 'error-message';
                    document.getElementById('cadastroMessage').innerHTML = data.message;
                    document.getElementById('cadastroMessage').style.display = 'block';
                    showToast(data.message, 'error');
                }
            } catch (error) {
                hideLoading();
                showToast('Erro ao cadastrar', 'error');
            }
        }

        function logout() {
            localStorage.clear();
            token = null;
            usuario = null;
            showToast('Logout realizado com sucesso!', 'info');
            // ?? USAR A FUNÃ¯Â¿Â½Ã¯Â¿Â½O DO UI.JS
            if (typeof window.mostrarLanding === 'function') {
                window.mostrarLanding();
            } else {
                mostrarLanding();
            }
            if (typeof window.mostrarLogin === 'function') {
                window.mostrarLogin();
            } else {
                mostrarLogin();
            }
        }

        function carregarMenu() {
            const usuarioStr = localStorage.getItem('usuario');
            const usuario = usuarioStr ? JSON.parse(usuarioStr) : null;

            console.log('Ã°Å¸â€œâ€¹ Carregando menu para:', usuario?.nome);
            console.log('Ã°Å¸â€Â Role:', usuario?.role);

            const sidebar = document.getElementById('sidebar');
            let botoes = [];

            if (!usuario) {
                console.warn('Ã¢Å¡Â Ã¯Â¸Â Nenhum usuÃƒÂ¡rio encontrado');
                return;
            }

            // Ã°Å¸â€Â¥ CORREÃƒâ€¡ÃƒÆ’O: Verificar se ÃƒÂ© Super Admin corretamente
            const isSuperAdmin = usuario.role === 'super_admin' || usuario.role === 'superadmin';
            const isProfissional = usuario.role === 'profissional';
            const isDono = usuario.role === 'dono';

            console.log('Ã°Å¸â€Â isSuperAdmin:', isSuperAdmin);

            if (isSuperAdmin) {
                // Ã°Å¸â€Â¥ SUPER ADMIN - Menu correto (apenas 4 opÃƒÂ§ÃƒÂµes)
                botoes = [
                    { id: 'dashboard', nome: 'Dashboard', icone: 'fa-chart-pie', funcao: 'carregarDashboard' },
                    { id: 'empresas', nome: 'Empresas', icone: 'fa-building', funcao: 'carregarEmpresas' },
                    { id: 'whatsapp', nome: 'WhatsApp', icone: 'fa-whatsapp', funcao: 'carregarWhatsappConfig' },
                    { id: 'planos', nome: 'Planos', icone: 'fa-crown', funcao: 'carregarPlanos' }
                ];
            } else if (isProfissional) {
                botoes = [
                    { id: 'dashboard', nome: 'Dashboard', icone: 'fa-chart-line', funcao: 'carregarDashboardProfissional' },
                    { id: 'agendamentos', nome: 'Meus Agendamentos', icone: 'fa-calendar-alt', funcao: 'carregarAgendamentosProfissional' }
                ];
            } else if (isDono) {
                // Dono - Menu completo
                botoes = [
                    { id: 'dashboard', nome: 'Dashboard', icone: 'fa-chart-line', funcao: 'carregarDashboard' },
                    { id: 'agendamentos', nome: 'Agendamentos', icone: 'fa-calendar-check', funcao: 'carregarAgendamentos' },
                    { id: 'servicos', nome: 'ServiÃƒÂ§os', icone: 'fa-clipboard-list', funcao: 'carregarServicos' },
                    { id: 'financeiro', nome: 'Financeiro', icone: 'fa-coins', funcao: 'carregarFinanceiro' },
                    { id: 'clientes', nome: 'Clientes', icone: 'fa-users', funcao: 'carregarClientes' },
                    { id: 'configuracoes', nome: 'ConfiguraÃƒÂ§ÃƒÂµes', icone: 'fa-gear', funcao: 'carregarConfiguracoes' },
                    { id: 'whatsapp', nome: 'Ã°Å¸â€œÂ± WhatsApp', icone: 'fa-whatsapp', funcao: 'carregarWhatsappConfig' },
                    { id: 'planos', nome: 'Ã°Å¸â€™Å½ Planos', icone: 'fa-gem', funcao: 'carregarPlanos' }
                ];
            }

            // Gerar HTML dos botÃƒÂµes
            sidebar.innerHTML = botoes.map(b =>
                `<button onclick="executarAcao('${b.funcao}', '${b.id}')" id="btn${b.id}"><i class="fas ${b.icone}"></i> ${b.nome}</button>`
            ).join('');

            // Ativar o botÃƒÂ£o correto
            const urlParams = new URLSearchParams(window.location.search);
            const page = urlParams.get('page') || 'dashboard';
            ativarBotao(page);
        }
        function ativarBotao(id) {
            document.querySelectorAll('.sidebar button').forEach(btn => btn.classList.remove('active'));
            const btn = document.getElementById('btn' + id);
            if (btn) btn.classList.add('active');
        }

        function mostrarApp() {
            const usuarioStr = localStorage.getItem('usuario');
            const usuario = usuarioStr ? JSON.parse(usuarioStr) : null;

            console.log('Ã°Å¸â€œÂ± Mostrando app...', usuario);

            if (!usuario || !usuario.nome) {
                console.warn('Ã¢Å¡Â Ã¯Â¸Â UsuÃƒÂ¡rio invÃƒÂ¡lido, redirecionando para login');
                localStorage.removeItem('token');
                localStorage.removeItem('usuario');
                mostrarLanding();
                mostrarLogin();
                return;
            }

            document.getElementById('landingContainer').style.display = 'none';
            document.getElementById('app').style.display = 'block';

            const userNameEl = document.getElementById('userName');
            const userBadgeEl = document.getElementById('userBadge');

            if (userNameEl) {
                userNameEl.textContent = 'Ã°Å¸â€˜Â¤ ' + (usuario?.nome || 'UsuÃƒÂ¡rio');
            }

            if (userBadgeEl) {
                const isSuperAdmin = usuario.role === 'super_admin' || usuario.role === 'superadmin';
                if (isSuperAdmin) {
                    userBadgeEl.innerHTML = '<span class="badge-super">Ã°Å¸â€Â´ SUPER ADMIN</span>';
                } else if (usuario?.role === 'profissional') {
                    userBadgeEl.innerHTML = '<span class="badge-profissional">Ã°Å¸â€Âµ PROFISSIONAL</span>';
                } else {
                    userBadgeEl.innerHTML = '<span class="badge-dono">Ã°Å¸Å¸Â  ProprietÃƒÂ¡rio</span>';
                }
            }

            // Ã°Å¸â€Â¥ CARREGAR O MENU
            carregarMenu();

            // Ã°Å¸â€Â¥ CARREGAR A PÃƒÂGINA CORRETA
            const isSuperAdmin = usuario.role === 'super_admin' || usuario.role === 'superadmin';
            if (isSuperAdmin) {
                if (typeof carregarDashboard === 'function') carregarDashboard();
            } else if (usuario?.role === 'profissional') {
                if (typeof carregarDashboardProfissional === 'function') carregarDashboardProfissional();
            } else {
                if (typeof carregarDashboard === 'function') carregarDashboard();
            }
        }
        // ========== FECHAR MODAL AO CLICAR FORA ==========
        window.onclick = function (event) {
            if (event.target.classList.contains('modal')) {
                event.target.style.display = 'none';
            }
        };

        // ========== ENTER KEY ==========
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                if (document.getElementById('loginContainer').style.display !== 'none') {
                    fazerLogin();
                } else if (document.getElementById('cadastroContainer').style.display !== 'none') {
                    fazerCadastro();
                }
            }
        });

        // ========== FECHAR MODAIS COM ESC ==========
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                document.querySelectorAll('.modal').forEach(modal => {
                    modal.style.display = 'none';
                });
            }
        });

        // ========== CORREÃ¯Â¿Â½Ã¯Â¿Â½O: CONECTAR O FORMULÃ¯Â¿Â½RIO DE CLIENTE ==========
        document.addEventListener('DOMContentLoaded', function () {
            console.log('?? Configurando formulÃ¯Â¿Â½rio de cliente...');
            const form = document.getElementById('formCliente');
            if (form) {
                console.log('? FormulÃ¯Â¿Â½rio de cliente encontrado!');
                const newForm = form.cloneNode(true);
                form.parentNode.replaceChild(newForm, form);
                newForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('?? FormulÃ¯Â¿Â½rio de cliente submetido!');
                    if (typeof window.salvarCliente === 'function') {
                        window.salvarCliente();
                    } else {
                        console.error('? salvarCliente nÃ¯Â¿Â½o estÃ¯Â¿Â½ disponÃ¯Â¿Â½vel!');
                        showToast('Erro: funÃ¯Â¿Â½Ã¯Â¿Â½o salvarCliente nÃ¯Â¿Â½o encontrada', 'error');
                    }
                });
                console.log('? Evento de submit conectado com sucesso!');
            } else {
                console.error('? FormulÃ¯Â¿Â½rio com id="formCliente" nÃ¯Â¿Â½o encontrado!');
            }
        });

        // ========== INIT ==========
        const savedToken = localStorage.getItem('token');
        const savedUsuario = localStorage.getItem('usuario');
        const savedEmail = localStorage.getItem('rememberEmail');
        if (savedEmail) {
            document.getElementById('loginEmail').value = savedEmail;
            document.getElementById('rememberMe').checked = true;
        }

        // ========== TEMA ESCURO POR PADRÃ¯Â¿Â½O ==========
        const temaSalvo = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', temaSalvo);
        localStorage.setItem('theme', temaSalvo);

        if (savedToken && savedUsuario) {
            token = savedToken;
            usuario = savedUsuario && savedUsuario !== 'undefined' ? JSON.parse(savedUsuario) : null;
            mostrarApp();
        } else {
            // ?? USAR A FUNÃ¯Â¿Â½Ã¯Â¿Â½O DO UI.JS
            if (typeof window.mostrarLanding === 'function') {
                window.mostrarLanding();
            } else {
                mostrarLanding();
            }
            if (typeof window.mostrarLogin === 'function') {
                window.mostrarLogin();
            } else {
                mostrarLogin();
            }
        }
        // ForÃƒÂ§ar recarregamento da versÃƒÂ£o
        console.log('Ã¢Å“â€¦ index.html versÃƒÂ£o: 2026-08-04-v2');
    </script>


</body>

</html>