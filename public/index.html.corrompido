        <div class="sidebar sidebar-glass" id="sidebar"></div>
        <div class="main">
            <div id="trialInfo" class="trial-info" style="display:none"></div>
            <div id="content"></div>
        </div>
    </div>

    <!-- MODAL CLIENTE -->
    <div id="modalCliente" class="modal">
        <div class="modal-content glass">
            <span class="close" onclick="fecharModalCliente()">&times;</span>
            <h3 id="modalClienteTitle">Novo Cliente</h3>
            <form id="formCliente">
                <input type="hidden" id="clienteId">
                <div class="form-group">
                    <label>Nome *</label>
                    <input type="text" id="clienteNome" class="form-control" placeholder="Nome completo" required>
                </div>
                <div class="form-group">
                    <label>Telefone</label>
                    <input type="text" id="clienteTelefone" class="form-control" placeholder="(41) 99999-9999">
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" id="clienteEmail" class="form-control" placeholder="email@exemplo.com">
                </div>
                <div class="modal-buttons">
                    <button type="submit" class="btn-3d">Salvar</button>
                    <button type="button" onclick="fecharModalCliente()" class="btn-secondary">Cancelar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL EMPRESA -->
    <div id="modalEditarEmpresa" class="modal">
        <div class="modal-content glass">
            <span class="close" onclick="fecharModal('modalEditarEmpresa')">&times;</span>
            <h3>?? Editar Empresa</h3>
            <form id="formEmpresa">
                <input type="hidden" id="editEmpresaId">
                <div class="form-group">
                    <label>Nome da Empresa *</label>
                    <input type="text" id="editEmpresaNome" class="form-control" placeholder="Nome" required>
                </div>
                <div class="form-group">
                    <label>Plano</label>
                    <select id="editEmpresaPlano" class="form-control">
                        <option value="trial">Trial</option>
                        <option value="Starter">Starter</option>
                        <option value="Pro">Pro</option>
                        <option value="Business">Business</option>
                        <option value="Enterprise">Enterprise</option>
                    </select>
                </div>
                <div class="modal-buttons" style="display:flex;gap:8px;margin-top:12px;">
                    <button type="submit" class="btn-3d" style="flex:1;">
                        <i class="fas fa-save"></i> Salvar
                    </button>
                    <button type="button" onclick="fecharModal('modalEditarEmpresa')" class="btn-secondary">
                        Cancelar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL UPGRADE -->
    <div id="modalUpgrade" class="modal">
