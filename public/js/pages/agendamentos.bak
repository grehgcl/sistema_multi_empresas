                                    <button onclick="salvarExtrasModal(${agendamentoId})" style="
                                        padding: ${isMobile ? '6px 16px' : '10px 24px'}; 
                                        border-radius: 8px; 
                                        border: none; 
                                        background: linear-gradient(135deg, #22c55e, #16a34a); 
                                        color: white; 
                                        font-size: ${isMobile ? '12px' : '14px'}; 
                                        font-weight: 600; 
                                        cursor: pointer;
                                        display: flex;
                                        align-items: center;
